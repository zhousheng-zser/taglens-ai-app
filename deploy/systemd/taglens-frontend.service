[Unit]
Description=TagLens AI 前端 (start.sh)
Documentation=file:/opt/Traffic-LLM/zser/taglens-ai-app/README.md
After=network-online.target taglens-backend.service
Wants=network-online.target
PartOf=taglens.target

[Service]
Type=simple
WorkingDirectory=/opt/Traffic-LLM/zser/taglens-ai-app
ExecStart=/bin/bash /opt/Traffic-LLM/zser/taglens-ai-app/start.sh

Restart=on-failure
RestartSec=5
TimeoutStartSec=300
TimeoutStopSec=45

StandardOutput=journal
StandardError=journal
SyslogIdentifier=taglens-frontend

[Install]
WantedBy=taglens.target
